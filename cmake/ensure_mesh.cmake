if(NOT DEFINED GEN OR NOT DEFINED DIR)
  message(FATAL_ERROR "GEN and DIR are required")
endif()
file(MAKE_DIRECTORY "${DIR}")
file(GLOB existing "${DIR}/*.cmf")
if(existing)
  return()
endif()
set(out "${DIR}/soccar_cleanroom.cmf")
execute_process(COMMAND "${GEN}" "${out}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "clean-room mesh generator failed (${rc})")
endif()
