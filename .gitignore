# Build artifacts
build/
*.o
*.a

# Runtime-generated / user-supplied arena collision meshes.
#
# NEVER commit collision_meshes/: a dump produced by RLArenaCollisionDumper is
# Psyonix-owned geometry and must stay a runtime-only, user-supplied input
# (repo rule 1). The in-repo clean-room mesh is NOT tracked here either — it is
# regenerated deterministically by `make meshgen`. See docs/MESH_SETUP.md.
collision_meshes/

# Local scratch
*.ppm
render_pacing.log
__pycache__/
*.pyc

# Local camera-decomp workspace (repo rule 1).
#
# decomp/ holds the camera symbol fixture extracted from the user's OWN Rocket
# League install (tools/decomp/camera_surface.py) plus any decrypted package or
# decompiled text. Psyonix-derived data never enters the tree; the in-repo
# tooling is ours (MIT) and the derived FACTS live in docs/CAMERA_DECOMP.md.
/decomp/

# Ripped arena packs (repo rule 1).
#
# arena_assets/ holds the arena packs produced by `tools/arena/rip_arena.py`
# (arena.json + arena.bin).  They are a container of Psyonix-owned mesh and
# texture data ripped from the user's OWN install, so they are runtime-only,
# user-local inputs and must never be committed or re-uploaded.  The pack
# FORMAT is documented in docs/ARENA_PACK.md; the tool is ours (MIT).
arena_assets/
